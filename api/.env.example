# Chatterfy Bot Settings → Webhooks & API webhook URL
# Keep the POSTBACK_ID secret and never commit the real value.
CHATTERFY_WEBHOOK_URL=

# Optional SQLite database path
DB_PATH=broker_crm.db

# Bot token from @BotFather. When set, the API trusts only signed Telegram
# initData and ignores the forgeable X-Telegram-Username header.
TELEGRAM_BOT_TOKEN=

# Optional: chat/group id that receives "New FTD" notifications from the bot.
TELEGRAM_NOTIFY_CHAT_ID=
# Comma-separated events to notify about (default: FTD)
NOTIFY_EVENTS=FTD

# Optional: shared secret for /webhook/chatterfy (add ?secret=<value> to the Chatterfy webhook URL)
CHATTERFY_WEBHOOK_SECRET=

# Local development only: allow the X-Telegram-Username header without a bot token
# ALLOW_USERNAME_HEADER=1
